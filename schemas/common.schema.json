{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://csmju2030.ac.th/schemas/common.schema.json",
  "title": "CommonResponseEnvelope",
  "type": "object",
  "required": ["success", "meta"],
  "properties": {
    "success": { "type": "boolean" },
    "data": {},
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "CONFLICT",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string" }
      }
    },
    "meta": { "type": "object" }
  }
}
