{
  "$comment": "ชื่อ event ปิดสำหรับ structured log ด้านการยืนยันตัวตน/สิทธิ์",
  "standardsVersion": "1.0",
  "required": [
    {
      "event": "subsystem.started",
      "fields": [
        "subsystem",
        "port",
        "coreHubUrl",
        "jwksUrl",
        "issuer",
        "audience"
      ]
    },
    {
      "event": "jwt.verification.success",
      "fields": [
        "sub",
        "coreRole",
        "subsystemRole"
      ]
    },
    {
      "event": "jwt.verification.failure",
      "fields": [
        "reason",
        "kid",
        "path"
      ]
    },
    {
      "event": "jwks.refresh",
      "fields": [
        "reason",
        "keyCount",
        "kids"
      ]
    },
    {
      "event": "jwks.refresh.failure",
      "fields": [
        "reason",
        "cachedKeyCount"
      ]
    },
    {
      "event": "jwks.unknown_kid",
      "fields": [
        "kid",
        "knownKids"
      ]
    },
    {
      "event": "authorization.role_mapping_failed",
      "fields": [
        "sub",
        "coreRole"
      ]
    },
    {
      "event": "authorization.denied",
      "fields": [
        "sub",
        "subsystemRole",
        "required",
        "reason",
        "path"
      ]
    }
  ],
  "failureReasons": [
    "missing_token",
    "malformed_token",
    "unsupported_algorithm",
    "missing_kid",
    "unknown_kid",
    "jwks_unavailable",
    "invalid_signature",
    "expired",
    "invalid_issuer",
    "invalid_audience",
    "invalid_claims"
  ],
  "mustNeverLog": [
    "access token",
    "refresh token",
    "Authorization header",
    "password",
    "private key"
  ]
}
